{
  "name": "aksel-arcade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs",
    "desktop:build": "npm run desktop:icons && npm run aksel:refresh-mcp-catalog && node scripts/build-sandbox.mjs && node scripts/build-desktop-main.mjs && vite build --config vite.desktop.config.ts",
    "desktop:package": "npm run desktop:package:mac",
    "desktop:package:mac": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "desktop:package:mac:release": "node scripts/desktop-macos-release-signing.cjs package",
    "desktop:package:win": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "desktop:release-plan": "node scripts/desktop-release-plan.cjs",
    "desktop:release-workflow-plan": "node scripts/desktop-release-workflow-plan.cjs",
    "desktop:release-env-check": "node scripts/desktop-release-environment-check.cjs",
    "desktop:pr-package-plan": "node scripts/desktop-pr-packaging-plan.cjs",
    "build": "node scripts/build-sandbox.mjs && tsc -b && vite build",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "share-strategy-bench": "node scripts/share-strategy-bench.mjs",
    "aksel:refresh-docs": "tsx --tsconfig tsconfig.node.json scripts/generate-aksel-autocomplete-data.ts --write src/data/akselAutocompleteData.ts",
    "aksel:refresh-mcp-catalog": "tsx --tsconfig tsconfig.node.json scripts/generate-mcp-aksel-catalog.ts --write",
    "aksel:audit": "tsx --tsconfig tsconfig.node.json scripts/aksel-audit.ts"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.5",
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@navikt/aksel-icons": "8.11.0",
    "@navikt/ds-css": "8.11.0",
    "@navikt/ds-react": "8.11.0",
    "@uiw/codemirror-themes": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "brotli-wasm": "^3.0.1",
    "fflate": "^0.8.2",
    "lz-string": "^1.5.0",
    "lzma": "^2.3.2",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^3.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@navikt/aksel-stylelint": "^7.33.1",
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^27.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.0.16",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@electron/get": {
      "undici": "^7.28.0"
    },
    "node-gyp": {
      "undici": "^6.27.0"
    }
  }
}
